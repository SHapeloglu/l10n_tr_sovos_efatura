<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Gelen Fatura Eşleme Wizard View                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_incoming_invoice_match_wizard" model="ir.ui.view">
        <field name="name">sovos.incoming.match.wizard.form</field>
        <field name="model">sovos.incoming.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Gelen Fatura Eşleme">
                <group>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                        <field name="partner_id" required="1"/>
                        <field name="partner_confidence" readonly="1"
                               widget="progressbar"/>
                        <field name="partner_source" readonly="1"/>
                    </group>
                    <group>
                        <field name="save_mappings"/>
                    </group>
                </group>

                <!-- Düşük partner güveni uyarısı -->
                <div class="alert alert-warning" role="alert"
                     invisible="partner_confidence &gt;= 85">
                    <strong>⚠ Tedarikçi eşlemesi düşük güvenli (%.0f%%). Lütfen doğrulayın.</strong>
                </div>

                <!-- Fatura Kalemleri -->
                <field name="line_ids">
                    <list editable="bottom" decoration-warning="confidence &lt; 0.85"
                          decoration-danger="confidence &lt; 0.60">
                        <field name="efatura_description" readonly="1"/>
                        <field name="efatura_quantity" readonly="1"/>
                        <field name="efatura_uom_code" readonly="1"/>
                        <field name="efatura_unit_price" readonly="1"/>
                        <field name="efatura_tax_percent" readonly="1"/>
                        <field name="confidence" readonly="1" widget="progressbar"/>
                        <field name="match_source" readonly="1"/>
                        <field name="product_id"/>
                        <field name="account_id"/>
                        <field name="tax_ids" widget="many2many_tags"/>
                        <field name="uom_id"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm" string="Onayla ve Kaydet"
                            type="object" class="btn btn-primary"/>
                    <button name="action_skip" string="Şimdilik Atla"
                            type="object" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Wizard Action — form butonundan açılır (action_open_incoming_   -->
    <!-- match_wizard Python metodunu destekler; context invoice_id'yi   -->
    <!-- wizard'a taşır)                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="action_incoming_invoice_match_wizard" model="ir.actions.act_window">
        <field name="name">Gelen Fatura Eşleme</field>
        <field name="res_model">sovos.incoming.match.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_invoice_id': active_id}</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Bekletme Kuyruğu — Eşleme Bekleyen Faturalar                   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="action_incoming_pending_invoices" model="ir.actions.act_window">
        <field name="name">Eşleme Bekleyen Gelen Faturalar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('move_type', '=', 'in_invoice'),
            ('x_efatura_match_status', 'in', ('pending', 'review'))
        ]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_incoming_matched_invoices" model="ir.actions.act_window">
        <field name="name">Eşlenmiş Gelen Faturalar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('move_type', '=', 'in_invoice'),
            ('x_efatura_match_status', 'in', ('matched', 'matched_auto'))
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Ürün Eşleme Tablosu View                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_efatura_product_mapping_list" model="ir.ui.view">
        <field name="name">efatura.product.mapping.list</field>
        <field name="model">efatura.product.mapping</field>
        <field name="arch" type="xml">
            <list string="e-Fatura Ürün Eşleme Tablosu">
                <field name="supplier_id"/>
                <field name="efatura_description"/>
                <field name="efatura_ubl_code"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="uom_id"/>
                <field name="confidence" widget="progressbar"/>
                <field name="usage_count"/>
                <field name="last_used"/>
            </list>
        </field>
    </record>

    <record id="view_efatura_product_mapping_form" model="ir.ui.view">
        <field name="name">efatura.product.mapping.form</field>
        <field name="model">efatura.product.mapping</field>
        <field name="arch" type="xml">
            <form string="e-Fatura Ürün Eşlemesi">
                <group string="e-Fatura Verisi (Tedarikçiden Gelen)">
                    <field name="supplier_id"/>
                    <field name="efatura_description"/>
                    <field name="efatura_ubl_code"/>
                </group>
                <group string="Odoo Eşlemesi">
                    <field name="product_id"/>
                    <field name="account_id"/>
                    <field name="tax_ids" widget="many2many_tags"/>
                    <field name="uom_id"/>
                </group>
                <group string="İstatistik">
                    <field name="confidence" readonly="1"/>
                    <field name="usage_count" readonly="1"/>
                    <field name="last_used" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_efatura_product_mapping" model="ir.actions.act_window">
        <field name="name">e-Fatura Ürün Eşleme Tablosu</field>
        <field name="res_model">efatura.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Menü Tanımları                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_efatura_incoming_root"
              name="Gelen e-Fatura"
              parent="account.menu_finance"
              sequence="100"/>

    <menuitem id="menu_efatura_incoming_pending"
              name="⏳ Eşleme Bekleyen"
              parent="menu_efatura_incoming_root"
              action="action_incoming_pending_invoices"
              sequence="10"/>

    <menuitem id="menu_efatura_incoming_matched"
              name="✅ Eşlenenler"
              parent="menu_efatura_incoming_root"
              action="action_incoming_matched_invoices"
              sequence="20"/>

    <menuitem id="menu_efatura_product_mapping"
              name="⚙ Ürün Eşleme Tablosu"
              parent="menu_efatura_incoming_root"
              action="action_efatura_product_mapping"
              sequence="30"/>

</odoo>
